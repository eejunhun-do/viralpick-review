# ViralPick server-only secrets. Set them in Vercel Project Settings > Environment Variables.
# Never place real keys in GitHub, frontend HTML, localStorage or public responses.
VIRALPICK_ACCESS_KEY=
OPENAI_API_KEY=
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=

# Account login + encrypted key vault (required for per-user settings)
# Provision Upstash Redis and set these only in Vercel (Production/Preview as appropriate).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use a long, random, fixed secret (32+ characters); do not rotate without migrating stored secrets.
VIRALPICK_APP_SECRET=
