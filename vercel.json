{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/v05.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/thread-hook-pairs",
      "destination": "/api/hooks?route=thread-pairs"
    },
    {
      "source": "/api/instagram-story",
      "destination": "/api/hooks?route=instagram-story"
    }
  ],
  "crons": [
    {
      "path": "/api/social-cron",
      "schedule": "* * * * *"
    }
  ]
}
